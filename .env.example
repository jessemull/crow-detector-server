# Crow Detector Server — local environment example
# Copy to `.env` and fill in real values. Never commit `.env`.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# PostgreSQL (TypeORM)
# -----------------------------------------------------------------------------
RDS_HOST=crow-detector-db-dev.example.us-west-2.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=crow_detector
RDS_USERNAME=
RDS_PASSWORD=
# Prefer proper RDS CA verification in non-dev. Set to false only temporarily.
# SSL_REJECT_UNAUTHORIZED=true

# -----------------------------------------------------------------------------
# ECDSA device public keys (base64-encoded PEM)
# -----------------------------------------------------------------------------
PI_USER_PUBLIC_KEY=
PI_MOTION_PUBLIC_KEY=
PI_FEEDER_PUBLIC_KEY=
LAMBDA_S3_PUBLIC_KEY=

# Optional local key paths for scripts/helpers
# PI_USER_PRIVATE_KEY_PATH=
# PI_MOTION_PRIVATE_KEY_PATH=
# PI_FEEDER_PRIVATE_KEY_PATH=

# -----------------------------------------------------------------------------
# AWS / S3 / Claude
# -----------------------------------------------------------------------------
AWS_REGION=us-west-2
S3_BUCKET_NAME=crow-detector-images-dev
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-opus-20240229
FEED_COOLDOWN_HOURS=4

# -----------------------------------------------------------------------------
# Local SSH tunnel / bastion (npm run start:tunnel / start:dev)
# -----------------------------------------------------------------------------
BASTION_HOST=
SSH_USER=ec2-user
SSH_KEY_PATH=~/.ssh/aws-key.pem
SSH_PORT=22
# DESTINATION_HOST defaults to RDS_HOST when unset
# DESTINATION_HOST=

# -----------------------------------------------------------------------------
# Lambda local packaging (optional; also set in AWS Lambda env)
# -----------------------------------------------------------------------------
# API_BASE_URL=https://api-dev.crittercanteen.com
# DETECTION_ENDPOINT=/detection
# FEED_ENDPOINT=/feed
# LAMBDA_S3_PRIVATE_KEY=
