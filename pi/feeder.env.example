# Copy to ~/feeder.env on the LAN host (chmod 600). Never commit real values.

FEEDER_API_BASE_URL=https://api-dev.crittercanteen.com
FEEDER_RTSP_URL=rtsp://CAMERA_USER:CAMERA_PASS@CAMERA_IP:554/stream1
# PI_FEEDER_PRIVATE_KEY_PATH=/home/juzu-inui/keys/pi-feeder-private.pem
# Animal visits use the same detector as the shelter. Defaults shown.
# FEEDER_PIXEL_DELTA=30
# FEEDER_MIN_CHANGED_RATIO=0.004
# FEEDER_MAX_CHANGED_RATIO=0.45
# FEEDER_LIGHT_DISARM_RATIO=0.80
# FEEDER_MIN_BLOB_FILL=0.25
# FEEDER_MOTION_FRAMES=3
# FEEDER_REFERENCE_ALPHA=0.02
# FEEDER_VISIT_GAP_SECONDS=120
# FEEDER_VISIT_CAP_SECONDS=600
# FEEDER_PRE_ROLL_SECONDS=4
# FEEDER_POST_ROLL_SECONDS=20
# FEEDER_SEGMENT_TIME_SECONDS=2
# Off by default: publish every motion visit. Set true to require Claude animal classify.
FEEDER_REQUIRE_ANIMAL=false
