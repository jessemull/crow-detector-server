# Copy to ~/porch.env on the LAN host (chmod 600). Never commit real values.

# Critter API used for ECDSA porch uploads (api-dev for bring-up; prod when ready).
PORCH_API_BASE_URL=https://api-dev.crittercanteen.com

# Full RTSP URL including Camera Account user/pass (host-only secret).
# Main stream is fine here; the recorder prefers stream2 for the warm pipeline.
PORCH_RTSP_URL=rtsp://CAMERA_USER:CAMERA_PASS@192.168.0.127:554/stream1

# Optional — defaults shown
# PORCH_RTSP_SAMPLE_URL=rtsp://CAMERA_USER:CAMERA_PASS@192.168.0.127:554/stream2
# PI_PORCH_PRIVATE_KEY_PATH=/home/porch/keys/pi-porch-private.pem
# PORCH_PIXEL_DELTA=30
# PORCH_MIN_CHANGED_RATIO=0.004
# PORCH_MAX_CHANGED_RATIO=0.45
# PORCH_LIGHT_DISARM_RATIO=0.80
# PORCH_MIN_BLOB_FILL=0.25
# PORCH_MOTION_FRAMES=3
# PORCH_REFERENCE_ALPHA=0.02
# PORCH_VISIT_GAP_SECONDS=120
# PORCH_VISIT_CAP_SECONDS=600
# PORCH_PRE_ROLL_SECONDS=4
# PORCH_POST_ROLL_SECONDS=20
# PORCH_SEGMENT_TIME_SECONDS=2
# PORCH_LOCAL_RETENTION_SECONDS=900
