# Copy to ~/porch.env on the LAN host (chmod 600). Never commit real values.

# Critter API used for ECDSA porch uploads (api-dev for bring-up; prod when ready).
PORCH_API_BASE_URL=https://api-dev.crittercanteen.com

# Full RTSP URL including Camera Account user/pass (host-only secret).
PORCH_RTSP_URL=rtsp://CAMERA_USER:CAMERA_PASS@192.168.0.127:554/stream1

# Optional — defaults shown
# PI_PORCH_PRIVATE_KEY_PATH=/home/porch/keys/pi-porch-private.pem
# PORCH_MOTION_THRESHOLD=0.035
# PORCH_MOTION_POLL_SECONDS=0.5
# PORCH_IDLE_SECONDS=3
# PORCH_VISIT_COOLDOWN_SECONDS=30
