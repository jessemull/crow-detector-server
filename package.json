{
  "name": "crow-detector",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "auth:token": "ts-node -r tsconfig-paths/register scripts/generate-auth-token.ts",
    "build": "nest build",
    "commit": "cz",
    "coverage:open": "open ./coverage/lcov-report/index.html",
    "db:reset": "ts-node -r tsconfig-paths/register scripts/db-seed/reset.ts",
    "db:seed": "ts-node -r tsconfig-paths/register scripts/db-seed/seed.ts",
    "db:synchronize": "ts-node -r tsconfig-paths/register scripts/db-seed/synchronize.ts",
    "db:test": "ts-node -r tsconfig-paths/register scripts/db-seed/test-connection.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"lambda/src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"lambda/src/**/*.ts\"",
    "lambda:build": "cd lambda && npm run build",
    "lambda:clean": "cd lambda && npm run clean",
    "lambda:test:coverage": "cd lambda && npm run test:coverage",
    "lambda:lint": "cd lambda && npm run lint",
    "lambda:format:check": "cd lambda && npm run format:check",
    "lambda:package": "cd lambda && npm run package",
    "lambda:test": "cd lambda && npm test",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prepare": "husky",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "NODE_ENV=development concurrently \"npm run start:tunnel\" \"npm run start:watch\"",
    "start:prod": "node dist/main",
    "start:tunnel": "node scripts/tunnel.js -l 5432 -r 5432 -t rds",
    "start:watch": "nest start --watch",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@aws-sdk/client-rekognition": "^3.1106.0",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.3",
    "@types/bunyan": "^1.8.11",
    "@types/crypto-js": "^4.2.2",
    "bunyan": "^1.8.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "crypto-js": "^4.2.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "commander": "^15.0.0",
    "commitizen": "^4.3.1",
    "concurrently": "^10.0.4",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "find-my-way": "^9.7.0"
  }
}
