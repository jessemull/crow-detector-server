[Unit]
Description=Critter Canteen porch RTSP recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Before enable: edit User, Group, WorkingDirectory, EnvironmentFile, and ExecStart
# to match the LAN host account and crow-detector-server clone path.
User=porch
Group=porch
WorkingDirectory=/home/porch/crow-detector-server
EnvironmentFile=-/home/porch/porch.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/porch/crow-detector-server/pi/record-on-motion.py
Restart=on-failure
RestartSec=10
# Keep the laptop awake while this unit runs when supported.
# ExecStartPre may be added for systemd-inhibit if the host sleeps aggressively.

[Install]
WantedBy=multi-user.target
