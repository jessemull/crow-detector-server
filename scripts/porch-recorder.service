[Unit]
Description=Critter Canteen porch RTSP recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Paths match the LAN host (juzu-inui): clone under ~/Development, secrets in ~.
# If you reinstall on another account, edit User/Group/WorkingDirectory/EnvironmentFile/ExecStart.
User=juzu-inui
Group=juzu-inui
WorkingDirectory=/home/juzu-inui/Development/crow-detector-server
EnvironmentFile=-/home/juzu-inui/porch.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/juzu-inui/Development/crow-detector-server/pi/record-on-motion.py
Restart=on-failure
RestartSec=10
# Keep the laptop awake while this unit runs when supported.
# ExecStartPre may be added for systemd-inhibit if the host sleeps aggressively.

[Install]
WantedBy=multi-user.target
