{
  "name": "crow-detector-s3-lambda",
  "version": "1.0.0",
  "description": "Lambda function to handle S3 events and call the Crow Detector API",
  "main": "dist/index.js",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint --ext .ts src/",
    "lint:fix": "eslint --ext .ts --fix src/",
    "package": "cd dist && zip -rq crow-detector-s3-lambda.zip ./*",
    "build:package": "npm run build && npm run package"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "keywords": [
    "aws",
    "lambda",
    "s3",
    "crow-detector",
    "typescript"
  ],
  "author": "Jesse Mull",
  "license": "MIT"
}
